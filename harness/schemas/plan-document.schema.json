{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan-document.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "spec", "specDigest", "baseCommit", "planner", "tasks"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "spec": {
      "type": "string",
      "pattern": "^specs/[0-9]{4}-[a-z][a-z0-9-]*\\.md$"
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tasks": {
      "$ref": "plan.schema.json"
    }
  }
}
