{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "description",
    "spec",
    "allowedPaths",
    "acceptanceCriteria",
    "dependsOn"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "description": "Repository-relative ownership path, not an agent name. Must equal an allowedPaths entry or be inside one. Prefer the primary allowedPaths entry; an ancestor of all allowed entries is invalid."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "spec": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Narrow repository-relative file or directory paths that this task may change. At least one entry must equal owner or contain owner as a descendant. Do not expand scope to fit an owner."
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
